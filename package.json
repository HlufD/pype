{
  "name": "pype-monorepo",
  "private": true,
  "description": "Pype: an Express 5 compatible web framework for Node.js, and related packages",
  "license": "ISC",
  "author": "Hluf Abebe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HlufD/pipe-router.git"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2"
  }
}
