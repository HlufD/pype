{
  "name": "pyper-web",
  "version": "0.1.2",
  "description": "Express 5 compatible web framework for Node.js with a radix tree router",
  "keywords": [
    "http",
    "router",
    "framework",
    "express",
    "middleware",
    "radix-tree",
    "typescript"
  ],
  "homepage": "https://github.com/HlufD/pipe-router/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/HlufD/pipe-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HlufD/pipe-router.git",
    "directory": "packages/core"
  },
  "license": "ISC",
  "author": "Hluf Abebe",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "FUZZ_RUNS=20000 vitest run tests/fuzz.test.ts tests/trie.test.ts tests/differential.test.ts --testTimeout=900000",
    "bench": "tsc && node .build/bench/http.bench.js",
    "bench:router": "tsc && node .build/bench/router.bench.js",
    "prepublishOnly": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.19",
    "@types/express-session": "^1.19.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/serve-static": "^2.2.0",
    "autocannon": "^8.0.0",
    "body-parser": "^2.3.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cookie-signature": "^1.2.2",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.7.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fast-check": "^4.10.2",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "serve-static": "^2.2.1"
  }
}
